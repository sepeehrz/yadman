# Neon Postgres connection string (pooled URL recommended for serverless).
# Get it from: https://console.neon.tech → your project → Connection Details.
# NEVER commit the real value — keep it in local `.env` (git-ignored).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Secret key for signing JWT auth tokens (openssl rand -base64 48).
JWT_SECRET="replace-with-a-long-random-secret"
